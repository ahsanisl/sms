# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Postgres connection string. Works with Supabase, or any other Postgres
# provider (self-managed, RDS, Railway, DigitalOcean, Hetzner, ...) — this is
# the ONLY infrastructure-specific setting in the app. No Supabase SDK/API is
# used anywhere; changing this string and re-running migrations is the whole
# migration path off Supabase.
#
# If you're using Supabase: Project Settings → Database → Connection string
# → "Transaction" pooler mode (port 6543) is recommended for serverless/edge
# environments; the direct connection (port 5432) also works for local dev.
DATABASE_URL="postgresql://user:password@host:5432/database"

# Sign-in (Better Auth — see src/auth.ts). A long random secret; generate one with:
#   openssl rand -base64 33
# (The older name AUTH_SECRET is still accepted.)
BETTER_AUTH_SECRET="replace-with-a-random-secret"
# The public address of the app, e.g. https://app.yourschool.com — used for
# cookies and in password-reset links. (AUTH_URL is still accepted.)
BETTER_AUTH_URL="http://localhost:3000"

# Optional. Password-reset emails ("Forgot password?"), sent through Resend
# (https://resend.com). Without RESEND_API_KEY the email is printed to the
# server log instead, and staff reset passwords from Users & Roles.
RESEND_API_KEY=""
EMAIL_FROM="EduFlow <no-reply@yourschool.com>"
# Test servers only: with no RESEND_API_KEY, write whole emails (including reset links) to the server log.
EMAIL_LOG_FULL="false"

# Optional. The school's time zone for "today", "this month" and default
# dates (an IANA name). Defaults to Asia/Karachi.
NEXT_PUBLIC_SCHOOL_TIME_ZONE="Asia/Karachi"

# Optional. Lists the demo accounts on the login page in a production build
# (they always show in development). Only for a demo site — never for a real school.
NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS="false"

# Optional. Which storage driver homework/classwork/syllabus attachments use
# — see src/lib/storage. "local" (the default if unset) saves files to
# ./storage/uploads on this server's disk; no other setup needed. Future
# drivers (e.g. "s3", "google_drive") will read their own additional env vars
# once added — swapping this value is the only app-code-free part of that move.
STORAGE_DRIVER="local"
